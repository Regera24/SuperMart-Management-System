# node_modules — largest folder, must always exclude
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (gets re-built in Docker)
dist/
build/

# Environment files (secrets must NOT be in image)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.iml

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db

# Optional coverage / test output
coverage/
*.lcov
